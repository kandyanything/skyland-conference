# Cloudflare Pages headers (replaces netlify.toml [[headers]] blocks).
# Extension-specific rules for feeds so .ics and .xml don't share one wildcard
# match — Cloudflare merges headers on overlapping rules rather than overriding.

/data/schedule/*
  Cache-Control: public, max-age=1800

/site.webmanifest
  Content-Type: application/manifest+json

/images/icons/*
  Cache-Control: public, max-age=604800

/feeds/all.ics
  Content-Type: text/calendar; charset=utf-8
  Cache-Control: public, max-age=1800

/feeds/schools/*.ics
  Content-Type: text/calendar; charset=utf-8
  Cache-Control: public, max-age=1800

/feeds/schools/*.xml
  Content-Type: application/rss+xml; charset=utf-8
  Cache-Control: public, max-age=1800

/feeds/sports/*.ics
  Content-Type: text/calendar; charset=utf-8
  Cache-Control: public, max-age=1800

/feeds/sports/*.xml
  Content-Type: application/rss+xml; charset=utf-8
  Cache-Control: public, max-age=1800

/feeds/rss.xml
  Content-Type: application/rss+xml; charset=utf-8
  Cache-Control: public, max-age=1800

/feeds/teams/*
  Content-Type: text/calendar; charset=utf-8
  Cache-Control: public, max-age=1800
